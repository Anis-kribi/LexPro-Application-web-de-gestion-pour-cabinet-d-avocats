{% extends 'baseauth.html.twig' %}

{% block title %}Connexion - LexPro{% endblock %}

{% block stylesheets %}
<style>
    /* Absolute Perfection - Premium Login Design */
    :root {
        --surface-main: #ffffff;
        --surface-side: #ffffff;
        --text-main: #0f172a;
        --text-muted: #64748b;
        --border-color: #e2e8f0;
        --input-bg: #f8fafc;
        --input-border: #cbd5e1;
        --input-focus: #ffffff;
        --primary-color: #4f46e5;
        --primary-hover: #4338ca;
        --left-bg-1: #0f172a;
        --left-bg-2: #020617;
    }

    [data-theme="dark"] {
        --surface-main: #0b1120;
        --surface-side: #0f172a;
        --text-main: #f1f5f9;
        --text-muted: #94a3b8;
        --border-color: #1e293b;
        --input-bg: #020617;
        --input-border: #334155;
        --input-focus: #020617;
        --primary-color: #6366f1;
        --primary-hover: #818cf8;
    }

    body {
        margin: 0;
        padding: 0;
        background: var(--surface-main);
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        color: var(--text-main);
        transition: background-color 0.4s ease, color 0.4s ease;
    }

    .login-container {
        display: flex;
        min-height: 100vh;
        overflow: hidden;
    }

    /* Theme Toggle */
    .theme-toggle-btn {
        position: absolute;
        top: 2.5rem;
        right: 3rem;
        width: 48px;
        height: 48px;
        border-radius: 50%;
        border: 1px solid var(--border-color);
        background: var(--surface-side);
        color: var(--text-muted);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.35rem;
        cursor: pointer;
        z-index: 100;
        transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        box-shadow: 0 4px 10px rgba(0,0,0,0.05);
    }
    .theme-toggle-btn:hover {
        transform: translateY(-3px) rotate(15deg) scale(1.05);
        color: var(--primary-color);
        border-color: var(--primary-color);
        box-shadow: 0 10px 15px -3px rgba(0,0,0,0.1);
    }

    /* Left Side - Majestic Abstract Branding */
    .login-visual {
        flex: 1.3;
        background: linear-gradient(135deg, var(--left-bg-1) 0%, var(--left-bg-2) 100%);
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem;
        overflow: hidden;
    }

    /* Glass Effect Showcase */
    .glass-showcase {
        position: relative;
        z-index: 10;
        background: rgba(255, 255, 255, 0.02);
        border: 1px solid rgba(255, 255, 255, 0.06);
        backdrop-filter: blur(30px);
        -webkit-backdrop-filter: blur(30px);
        border-radius: 36px;
        padding: 4.5rem;
        max-width: 720px;
        width: 100%;
        box-shadow: 0 40px 80px -20px rgba(0, 0, 0, 0.8), inset 0 0 0 1px rgba(255,255,255,0.05);
    }

    .glass-showcase::after {
        content: '';
        position: absolute;
        inset: 0;
        border-radius: 36px;
        padding: 2px;
        background: linear-gradient(135deg, rgba(255,255,255,0.2) 0%, rgba(255,255,255,0) 100%);
        -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
        -webkit-mask-composite: xor;
        mask-composite: exclude;
        pointer-events: none;
    }

    .showcase-icon {
        width: 76px;
        height: 76px;
        border-radius: 22px;
        background: linear-gradient(135deg, rgba(99,102,241,0.2), rgba(99,102,241,0.05));
        border: 1px solid rgba(99,102,241,0.3);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 2.2rem;
        color: #818cf8;
        margin-bottom: 2.5rem;
        box-shadow: 0 20px 40px -5px rgba(99,102,241,0.3);
    }

    .showcase-title {
        font-size: 3.8rem;
        font-weight: 800;
        color: #ffffff;
        margin-bottom: 1.5rem;
        line-height: 1.1;
        letter-spacing: -0.04em;
        background: linear-gradient(135deg, #ffffff 40%, #818cf8 100%);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .showcase-text {
        font-size: 1.25rem;
        color: #94a3b8;
        line-height: 1.8;
        margin-bottom: 4rem;
        font-weight: 400;
        max-width: 95%;
    }

    .feature-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 2.5rem 2rem;
    }

    .feature-item {
        display: flex;
        align-items: flex-start;
        gap: 1.25rem;
    }

    .feature-item-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 16px;
        background: rgba(255,255,255,0.05);
        color: #a5b4fc;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.45rem;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border: 1px solid rgba(255,255,255,0.05);
    }

    .feature-item:hover .feature-item-icon {
        transform: translateY(-4px);
        background: rgba(99, 102, 241, 0.2);
        color: #ffffff;
        border-color: rgba(99, 102, 241, 0.4);
        box-shadow: 0 10px 20px -5px rgba(99,102,241,0.3);
    }

    .feature-text-block h4 {
        color: #f1f5f9;
        font-weight: 700;
        font-size: 1.15rem;
        margin-bottom: 0.35rem;
        letter-spacing: -0.01em;
    }

    .feature-text-block p {
        color: #64748b;
        font-size: 0.95rem;
        margin: 0;
        line-height: 1.5;
    }

    /* Ambient animated lighting */
    .ambient-light {
        position: absolute;
        width: 700px;
        height: 700px;
        background: radial-gradient(circle, rgba(79, 70, 229, 0.35) 0%, rgba(0,0,0,0) 60%);
        border-radius: 50%;
        filter: blur(80px);
        animation: pulseLight 15s ease-in-out infinite alternate;
        z-index: 1;
        opacity: 0.6;
    }
    .ambient-1 { top: -25%; left: -25%; }
    .ambient-2 { bottom: -25%; right: -25%; background: radial-gradient(circle, rgba(16, 185, 129, 0.2) 0%, rgba(0,0,0,0) 60%); animation-delay: -5s; }

    @keyframes pulseLight {
        0% { transform: scale(1) translate(0, 0); opacity: 0.4; }
        100% { transform: scale(1.2) translate(80px, -80px); opacity: 0.8; }
    }

    /* Right Side - Form Area */
    .login-form-area {
        flex: 0 0 580px;
        background: var(--surface-side);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 4rem;
        position: relative;
        z-index: 20;
        box-shadow: -30px 0 60px -20px rgba(0,0,0,0.2);
        transition: background-color 0.4s ease;
    }

    .form-container {
        width: 100%;
        max-width: 440px;
    }

    .brand-logo-container {
        text-align: center;
        margin-bottom: 3.5rem;
    }

    .brand-logo-img {
        width: 260px; /* Massive, perfectly sized logo */
        height: auto;
        margin: 0 auto 1.5rem auto;
        display: block;
        transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
        filter: drop-shadow(0 15px 30px rgba(0,0,0,0.15));
    }

    [data-theme="dark"] .brand-logo-img {
        filter: drop-shadow(0 15px 30px rgba(0,0,0,0.4)) brightness(1.2);
    }

    .brand-logo-img:hover {
        transform: scale(1.05) translateY(-5px);
    }

    .form-title {
        font-size: 2.5rem;
        font-weight: 800;
        color: var(--text-main);
        margin-bottom: 0.75rem;
        letter-spacing: -0.03em;
    }

    .form-subtitle {
        color: var(--text-muted);
        font-size: 1.15rem;
        margin-bottom: 3rem;
    }

    /* Perfect Inputs */
    .input-group-modern {
        position: relative;
        margin-bottom: 1.75rem;
    }

    .input-group-modern i {
        position: absolute;
        left: 1.4rem;
        top: 50%;
        transform: translateY(-50%);
        color: var(--text-muted);
        font-size: 1.25rem;
        transition: color 0.3s ease;
        z-index: 10;
        pointer-events: none;
    }

    .input-modern {
        width: 100%;
        padding: 1.2rem 1rem 1.2rem 3.8rem;
        background: var(--input-bg);
        border: 2px solid var(--border-color);
        border-radius: 18px;
        font-size: 1.05rem;
        color: var(--text-main);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        font-family: inherit;
        box-shadow: inset 0 2px 4px 0 rgba(0,0,0,0.02);
    }

    .input-modern:focus {
        background: var(--input-focus);
        border-color: var(--primary-color);
        box-shadow: 0 0 0 4px rgba(79, 70, 229, 0.15);
        outline: none;
    }

    .input-modern:focus + i,
    .input-modern:not(:placeholder-shown) + i {
        color: var(--primary-color);
    }

    .input-modern::placeholder {
        color: var(--text-muted);
        opacity: 0.7;
    }

    /* Beautiful Options */
    .options-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 2.5rem;
        font-size: 0.95rem;
    }

    .checkbox-modern {
        display: flex;
        align-items: center;
        gap: 0.75rem;
        cursor: pointer;
        color: var(--text-muted);
        font-weight: 500;
        user-select: none;
    }

    .checkbox-modern input[type="checkbox"] {
        width: 22px;
        height: 22px;
        border-radius: 6px;
        border: 2px solid var(--border-color);
        background: var(--input-bg);
        appearance: none;
        cursor: pointer;
        position: relative;
        transition: all 0.2s;
    }

    .checkbox-modern input[type="checkbox"]:checked {
        background: var(--primary-color);
        border-color: var(--primary-color);
    }

    .checkbox-modern input[type="checkbox"]:checked::after {
        content: '';
        position: absolute;
        left: 7px;
        top: 3px;
        width: 5px;
        height: 10px;
        border: solid white;
        border-width: 0 2px 2px 0;
        transform: rotate(45deg);
    }

    .forgot-password {
        color: var(--primary-color);
        font-weight: 600;
        text-decoration: none;
        transition: all 0.2s ease;
    }
    .forgot-password:hover {
        color: var(--primary-hover);
        text-decoration: underline;
    }

    /* Primary Submit Button */
    .btn-submit-modern {
        width: 100%;
        padding: 1.2rem;
        background: linear-gradient(135deg, var(--primary-color) 0%, #3730a3 100%);
        color: white;
        border: none;
        border-radius: 18px;
        font-size: 1.1rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        box-shadow: 0 10px 25px -5px rgba(79, 70, 229, 0.4);
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
    }
    .btn-submit-modern:hover {
        transform: translateY(-3px);
        box-shadow: 0 15px 35px -5px rgba(79, 70, 229, 0.5);
    }
    .btn-submit-modern:active {
        transform: translateY(0);
    }
    .btn-submit-modern i {
        transition: transform 0.3s ease;
    }
    .btn-submit-modern:hover i {
        transform: translateX(4px);
    }

    /* Subdued Divider */
    .divider-modern {
        display: flex;
        align-items: center;
        margin: 2.5rem 0;
        color: var(--text-muted);
        font-size: 0.95rem;
        font-weight: 500;
    }
    .divider-modern::before,
    .divider-modern::after {
        content: "";
        flex: 1;
        height: 1px;
        background: var(--border-color);
    }
    .divider-modern span {
        padding: 0 1.25rem;
        opacity: 0.8;
    }

    /* Outline Button */
    .btn-outline-modern {
        width: 100%;
        padding: 1.2rem;
        background: transparent;
        color: var(--text-main);
        border: 2px solid var(--border-color);
        border-radius: 18px;
        font-size: 1.05rem;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.3s ease;
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 0.75rem;
        text-decoration: none;
    }
    .btn-outline-modern:hover {
        border-color: var(--text-muted);
        background: var(--input-bg);
        transform: translateY(-2px);
    }

    .error-alert-modern {
        background: rgba(220, 38, 38, 0.1);
        border: 1px solid rgba(220, 38, 38, 0.3);
        color: #ef4444;
        padding: 1.25rem 1.5rem;
        border-radius: 16px;
        margin-bottom: 2.5rem;
        display: flex;
        align-items: center;
        gap: 1.25rem;
        font-weight: 500;
    }
    
    /* Elegant Slide Up Animation */
    .animate-slide-up {
        animation: elegantSlideUp 0.8s cubic-bezier(0.16, 1, 0.3, 1) both;
    }
    
    @keyframes elegantSlideUp {
        0% { opacity: 0; transform: translateY(40px); }
        100% { opacity: 1; transform: translateY(0); }
    }

    @media (max-width: 1100px) {
        .login-visual {
            display: none;
        }
        .login-form-area {
            flex: 1;
            padding: 2.5rem;
            box-shadow: none;
        }
        .form-container {
            max-width: 480px;
        }
    }
</style>
{% endblock %}

{% block body %}
<!-- Theme Toggle Action -->
<button id="themeToggleBtn" class="theme-toggle-btn animate-slide-up" title="Basculer le mode sombre">
    <i class="bi bi-moon-stars-fill"></i>
</button>

<div class="login-container">
    {# Left Visual Showcase (Absolute Premium) #}
    <div class="login-visual">
        <div class="ambient-light ambient-1"></div>
        <div class="ambient-light ambient-2"></div>
        
        <div class="glass-showcase animate-slide-up" style="animation-duration: 1s;">
            <div class="showcase-icon">
                <i class="bi bi-fingerprint"></i>
            </div>
            <h1 class="showcase-title">Excellence Juridique.</h1>
            <p class="showcase-text">
                Élevez la gestion de votre cabinet à un niveau supérieur. Une interface sculptée au pixel près pour allier productivité et sécurité absolue.
            </p>
            
            <div class="feature-grid">
                <div class="feature-item animate-slide-up" style="animation-delay: 0.15s;">
                    <div class="feature-item-icon">
                        <i class="bi bi-briefcase"></i>
                    </div>
                    <div class="feature-text-block">
                        <h4>Dossiers Centralisés</h4>
                        <p>Toute votre activité, à portée de clic.</p>
                    </div>
                </div>
                <div class="feature-item animate-slide-up" style="animation-delay: 0.25s;">
                    <div class="feature-item-icon">
                        <i class="bi bi-graph-up"></i>
                    </div>
                    <div class="feature-text-block">
                        <h4>Suivi Analytique</h4>
                        <p>Des tableaux de bord d'une clarté absolue.</p>
                    </div>
                </div>
                <div class="feature-item animate-slide-up" style="animation-delay: 0.35s;">
                    <div class="feature-item-icon">
                        <i class="bi bi-calendar-check"></i>
                    </div>
                    <div class="feature-text-block">
                        <h4>Agenda Intelligent</h4>
                        <p>Ne manquez plus aucun rendez-vous clé.</p>
                    </div>
                </div>
                <div class="feature-item animate-slide-up" style="animation-delay: 0.45s;">
                    <div class="feature-item-icon">
                        <i class="bi bi-shield-lock"></i>
                    </div>
                    <div class="feature-text-block">
                        <h4>Sécurité Avancée</h4>
                        <p>Vos données sont isolées et protégées.</p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    {# Right Form Area #}
    <div class="login-form-area">
        <div class="form-container">
            <div class="brand-logo-container animate-slide-up" style="animation-delay: 0.1s;">
                <!-- Increased logo size perfectly -->
                <img src="/backend/images/LexPro.png" alt="LexPro Logo" class="brand-logo-img">
                <h2 class="form-title">Bienvenue</h2>
                <p class="form-subtitle">Saisissez vos identifiants pour continuer.</p>
            </div>

            {% if error %}
            <div class="error-alert-modern animate-slide-up" style="animation-delay: 0.2s;">
                <i class="bi bi-exclamation-triangle-fill fs-3"></i>
                <div>
                    <strong class="d-block mb-1">Erreur</strong>
                    <span style="opacity: 0.9;">{{ error.messageKey|trans(error.messageData, 'security') }}</span>
                </div>
            </div>
            {% endif %}

            <form method="post" class="animate-slide-up" style="animation-delay: 0.2s;">
                <div class="input-group-modern">
                    <input type="email"
                           value="{{ last_username }}"
                           name="email"
                           id="inputEmail"
                           class="input-modern"
                           placeholder="Adresse email professionnelle"
                           autocomplete="email"
                           required
                           autofocus>
                    <i class="bi bi-envelope"></i>
                </div>

                <div class="input-group-modern">
                    <input type="password"
                           name="password"
                           id="inputPassword"
                           class="input-modern"
                           placeholder="Mot de passe"
                           autocomplete="current-password"
                           required>
                    <i class="bi bi-lock"></i>
                </div>

                <div class="options-row">
                    <label class="checkbox-modern" for="rememberMe">
                        <input type="checkbox" name="_remember_me" id="rememberMe">
                        Se souvenir de moi
                    </label>
                    <a href="#" class="forgot-password">Mot de passe oublié ?</a>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <button class="btn-submit-modern" type="submit">
                    Accéder à mon espace <i class="bi bi-arrow-right fs-4"></i>
                </button>
            </form>

        </div>
    </div>
</div>

<!-- Scripts for Dark Mode -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const toggleBtn = document.getElementById('themeToggleBtn');
        const icon = toggleBtn.querySelector('i');
        
        // Define function to update icon
        const updateIcon = (theme) => {
            if (theme === 'dark') {
                icon.classList.replace('bi-moon-stars-fill', 'bi-sun-fill');
            } else {
                icon.classList.replace('bi-sun-fill', 'bi-moon-stars-fill');
            }
        };

        // Check saved theme or system preference
        const savedTheme = localStorage.getItem('theme');
        if (savedTheme === 'dark' || (!savedTheme && window.matchMedia('(prefers-color-scheme: dark)').matches)) {
            document.documentElement.setAttribute('data-theme', 'dark');
            updateIcon('dark');
        } else {
            // Ensure if it's explicitly light or undefined we set the icon correctly
            updateIcon('light');
        }

        // Toggle logic
        toggleBtn.addEventListener('click', () => {
            const currentTheme = document.documentElement.getAttribute('data-theme');
            if (currentTheme === 'dark') {
                document.documentElement.removeAttribute('data-theme');
                localStorage.setItem('theme', 'light');
                updateIcon('light');
            } else {
                document.documentElement.setAttribute('data-theme', 'dark');
                localStorage.setItem('theme', 'dark');
                updateIcon('dark');
            }
        });
    });
</script>
{% endblock %}
