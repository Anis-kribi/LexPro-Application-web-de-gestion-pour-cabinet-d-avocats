{% extends 'baseback.html.twig' %}

{% block title %}Modifier Client — LexPro{% endblock %}

{% block body %}
{# ── Page Header ── #}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-light border" title="Retour au client">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_client_index') }}"><i class="bi bi-people me-1"></i>Clients</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_client_show', {'id': client.id}) }}">{{ client.fullName }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Modifier le Client</h1>
            <p class="text-muted">{{ client.type|capitalize }} — {{ client.statuts }}</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Informations du client</h6>
            </div>
            <div class="card-body p-4">
                {{ include('client/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-shield-check"></i> Fiche actuelle</div>
            <ul>
                {% if client.email %}
                <li><i class="bi bi-envelope"></i> {{ client.email }}</li>
                {% endif %}
                {% if client.telephone %}
                <li><i class="bi bi-telephone"></i> {{ client.telephone }}</li>
                {% endif %}
                {% if client.ville %}
                <li><i class="bi bi-geo-alt"></i> {{ client.ville }}</li>
                {% endif %}
                <li><i class="bi bi-calendar"></i> Client depuis {{ client.createdAt ? client.createdAt|date('d/m/Y') : '—' }}</li>
            </ul>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <a href="{{ path('app_client_show', {'id': client.id}) }}" class="btn btn-light border w-100 mb-2">
                    <i class="bi bi-eye me-2"></i>Voir la fiche client
                </a>
                <a href="{{ path('app_client_index') }}" class="btn btn-light border w-100">
                    <i class="bi bi-people me-2"></i>Tous les clients
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
