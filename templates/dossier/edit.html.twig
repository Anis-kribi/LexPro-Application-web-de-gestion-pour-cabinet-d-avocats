{% extends 'baseback.html.twig' %}

{% block title %}Modifier Dossier — LexPro{% endblock %}

{% block body %}
{# ── Page Header ── #}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_dossier_show', {'id': dossier.id}) }}" class="btn btn-light border" title="Retour au dossier">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_dossier_index') }}"><i class="bi bi-folder2-open me-1"></i>Dossiers</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_dossier_show', {'id': dossier.id}) }}">{{ dossier.numeroReference }}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Modifier le Dossier</h1>
            <p class="text-muted">{{ dossier.titre|slice(0, 60) }}{% if dossier.titre|length > 60 %}...{% endif %}</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil-square text-primary me-2"></i>Informations du dossier</h6>
            </div>
            <div class="card-body p-4">
                {{ include('dossier/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-shield-check"></i> Informations actuelles</div>
            <ul>
                <li><i class="bi bi-folder2"></i> Réf: <strong>{{ dossier.numeroReference }}</strong></li>
                <li><i class="bi bi-person"></i> Client: <strong>{{ dossier.client.fullName }}</strong></li>
                <li><i class="bi bi-flag-fill"></i> Priorité: <strong>{{ dossier.priorite }}</strong></li>
                <li><i class="bi bi-circle-fill text-{{ {'En cours':'primary','Suspendu':'warning','Clôturé':'success','Archivé':'secondary'}[dossier.statuts] ?? 'secondary' }}" style="font-size:.5rem;vertical-align:middle;"></i> Statut: <strong>{{ dossier.statuts }}</strong></li>
            </ul>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <a href="{{ path('app_dossier_show', {'id': dossier.id}) }}" class="btn btn-light border w-100 mb-2">
                    <i class="bi bi-eye me-2"></i>Voir le dossier
                </a>
                <a href="{{ path('app_dossier_index') }}" class="btn btn-light border w-100">
                    <i class="bi bi-folder2-open me-2"></i>Tous les dossiers
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}