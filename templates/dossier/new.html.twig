{% extends 'baseback.html.twig' %}

{% block title %}Nouveau Dossier — LexPro{% endblock %}

{% block body %}
{# ── Page Header ── #}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_dossier_index') }}" class="btn btn-light border" title="Retour aux dossiers">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_dossier_index') }}"><i class="bi bi-folder2-open me-1"></i>Dossiers</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nouveau dossier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Ouvrir un Nouveau Dossier</h1>
            <p class="text-muted">Renseignez les informations de l'affaire pour la créer dans le système.</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-folder-plus text-primary me-2"></i>Informations du dossier</h6>
            </div>
            <div class="card-body p-4">
                {{ include('dossier/_form.html.twig') }}
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-lightbulb-fill"></i> Astuces</div>
            <ul>
                <li><i class="bi bi-info-circle"></i> La référence sera générée automatiquement si laissée vide.</li>
                <li><i class="bi bi-info-circle"></i> Un dossier doit toujours être rattaché à un client.</li>
                <li><i class="bi bi-info-circle"></i> Précisez bien la priorité pour le suivi dans le tableau de bord.</li>
                <li><i class="bi bi-info-circle"></i> Vous pourrez ajouter des documents et tâches après la création.</li>
            </ul>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <h6 class="fw-bold text-muted text-uppercase small mb-3"><i class="bi bi-diagram-3 me-1"></i>Statuts disponibles</h6>
                <div class="d-flex flex-wrap gap-2">
                    <span class="badge bg-primary bg-opacity-10 text-primary border border-primary rounded-pill px-2">En cours</span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning rounded-pill px-2">Suspendu</span>
                    <span class="badge bg-success bg-opacity-10 text-success border border-success rounded-pill px-2">Clôturé</span>
                    <span class="badge bg-secondary bg-opacity-10 text-secondary border border-secondary rounded-pill px-2">Archivé</span>
                </div>
            </div>
        </div>
    </div>
</div>
{% endblock %}