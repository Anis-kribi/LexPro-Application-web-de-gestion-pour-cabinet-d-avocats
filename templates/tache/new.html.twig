{% extends 'baseback.html.twig' %}

{% block title %}Nouvelle Tâche — LexPro{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_tache_index') }}" class="btn btn-light border" title="Retour">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_tache_index') }}"><i class="bi bi-check2-square me-1"></i>Tâches</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nouvelle tâche</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Créer une Nouvelle Tâche</h1>
            <p class="text-muted">Planifiez et assignez une action à effectuer sur un dossier.</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-plus-square text-primary me-2"></i>Détails de la tâche</h6>
            </div>
            <div class="card-body p-4">
                {{ include('tache/_form.html.twig') }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-lightbulb-fill"></i> Conseils</div>
            <ul>
                <li><i class="bi bi-info-circle"></i> Choisissez la priorité "Urgente" pour les délais critiques.</li>
                <li><i class="bi bi-info-circle"></i> Assignez la tâche à un collaborateur pour un suivi précis.</li>
                <li><i class="bi bi-info-circle"></i> La date d'échéance vous alertera en cas de retard.</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}
