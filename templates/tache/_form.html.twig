{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

<div class="row g-4">
    <div class="col-md-12 mb-2">
        <div class="form-group">
            {{ form_label(form.titre) }}
            {{ form_widget(form.titre, {'attr': {'class': 'form-control form-control-lg'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.titre) }}</div>
        </div>
    </div>

    <div class="col-md-6 border-end">
        <div class="form-group mb-3">
            {{ form_label(form.dossier) }}
            {{ form_widget(form.dossier, {'attr': {'class': 'form-select select2'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.dossier) }}</div>
        </div>
        <div class="form-group mb-3">
            {{ form_label(form.assigneA) }}
            {{ form_widget(form.assigneA, {'attr': {'class': 'form-select'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.assigneA) }}</div>
        </div>
    </div>

    <div class="col-md-6">
        <div class="form-group mb-3">
            {{ form_label(form.dateEcheance) }}
            {{ form_widget(form.dateEcheance, {'attr': {'class': 'form-control'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.dateEcheance) }}</div>
        </div>
        <div class="row">
            <div class="col-md-6">
                <div class="form-group mb-3">
                    {{ form_label(form.status) }}
                    {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
            <div class="col-md-6">
                <div class="form-group mb-3">
                    {{ form_label(form.priorite) }}
                    {{ form_widget(form.priorite, {'attr': {'class': 'form-select'}}) }}
                </div>
            </div>
        </div>
    </div>

    <div class="col-12 mt-3 pt-3 border-top">
        <div class="form-group mb-3">
            {{ form_label(form.description) }}
            {{ form_widget(form.description, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 border-top pt-4">
    <a href="{{ path('app_tache_index') }}" class="btn btn-light border">Annuler</a>
    <button class="btn btn-primary">{{ button_label|default('Enregistrer la tâche') }}</button>
</div>

{{ form_end(form) }}
