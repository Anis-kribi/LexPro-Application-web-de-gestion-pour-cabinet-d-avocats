{% extends 'baseback.html.twig' %}

{% block title %}Modifier Tâche — LexPro{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_tache_show', {'id': tache.id}) }}" class="btn btn-light border" title="Retour">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_tache_index') }}"><i class="bi bi-check2-square me-1"></i>Tâches</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_tache_show', {'id': tache.id}) }}">{{ tache.titre|slice(0,30) }}{% if tache.titre|length > 30 %}...{% endif %}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Modifier la Tâche</h1>
            <p class="text-muted">Dossier : {{ tache.dossier.numeroReference }} — Statut : {{ tache.status }}</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Détails de la tâche</h6>
            </div>
            <div class="card-body p-4">
                {{ include('tache/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-shield-check"></i> État actuel</div>
            <ul>
                <li><i class="bi bi-flag-fill"></i> Priorité: <strong>{{ tache.priorite }}</strong></li>
                <li><i class="bi bi-calendar"></i> Échéance: <strong>{{ tache.dateEcheance ? tache.dateEcheance|date('d/m/Y') : 'Non définie' }}</strong></li>
                {% if tache.assigneA %}
                <li><i class="bi bi-person"></i> Assigné à: <strong>{{ tache.assigneA.fullName }}</strong></li>
                {% endif %}
                {% if tache.isEnRetard %}<li><i class="bi bi-exclamation-triangle text-danger"></i> <span class="text-danger fw-bold">En retard !</span></li>{% endif %}
            </ul>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <a href="{{ path('app_tache_show', {'id': tache.id}) }}" class="btn btn-light border w-100 mb-2">
                    <i class="bi bi-eye me-2"></i>Voir la tâche
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
