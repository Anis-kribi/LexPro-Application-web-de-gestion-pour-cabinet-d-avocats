{% extends 'baseback.html.twig' %}

{% block title %}Modifier Saisie Temps — LexPro{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_entree_temps_index') }}" class="btn btn-light border" title="Retour">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_entree_temps_index') }}"><i class="bi bi-clock-history me-1"></i>Temps</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Modifier Saisie</h1>
            <p class="text-muted">Dossier: {{ entree.dossier.numeroReference }}</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Détails de la saisie</h6>
            </div>
            <div class="card-body p-4">
                {{ include('entree_temps/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
    
    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-shield-check"></i> Saisie actuelle</div>
            <p class="small text-muted mb-3">Si vous modifiez le temps passé, assurez-vous que cela corresponde à la réalité de la prestation pour le dossier <strong>{{ entree.dossier.numeroReference }}</strong>.</p>
            <ul>
                <li><i class="bi bi-clock"></i> Durée actuelle: <strong>{{ entree.heures }}h</strong></li>
                <li><i class="bi bi-calendar"></i> Date: <strong>{{ entree.date ? entree.date|date('d/m/Y') : '—' }}</strong></li>
            </ul>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <a href="{{ path('app_entree_temps_index') }}" class="btn btn-light border w-100">
                    <i class="bi bi-list-ul me-2"></i>Toutes les saisies
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}
