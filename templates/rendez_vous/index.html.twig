{% extends 'baseback.html.twig' %}

{% block title %}Rendez-vous — LexPro{% endblock %}

{% block body %}
{# ── Page Header ── #}
<div class="page-header mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div class="d-flex align-items-center gap-3">
            <div class="bg-primary bg-opacity-10 text-primary rounded-3 p-3 d-flex align-items-center justify-content-center">
                <i class="bi bi-calendar-event fs-3"></i>
            </div>
            <div>
                <h1 class="mb-0 fw-bold">Rendez-vous</h1>
                <p class="text-muted mb-0">Gestion de l'agenda et des consultations</p>
            </div>
        </div>
        <div class="d-flex gap-2">
            <div class="btn-group" role="group">
                <a href="{{ path('app_rendez_vous_index') }}" class="btn btn-primary active" title="Vue Liste">
                    <i class="bi bi-list-ul"></i> Liste
                </a>
                <a href="{{ path('app_rendez_vous_calendar') }}" class="btn btn-outline-primary" title="Vue Calendrier">
                    <i class="bi bi-calendar3"></i> Calendrier
                </a>
            </div>
            <a href="{{ path('app_rendez_vous_new') }}" class="btn btn-primary shadow-sm">
                <i class="bi bi-plus-lg me-2"></i>Nouveau RDV
            </a>
        </div>
    </div>
</div>

{# ── Flash Messages ── #}
<div class="flash-container">
{% for message in app.flashes('success') %}
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill"></i> {{ message }}
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
{% endfor %}
</div>

{# ── Data Table ── #}
<div class="card border-0 shadow-sm">
    <div class="card-body p-0">
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead>
                    <tr>
                        <th class="ps-4">Date</th>
                        <th>Client</th>
                        <th>Statut</th>
                        <th class="text-end pe-4">Actions</th>
                    </tr>
                </thead>
                <tbody>
                {% for rdv in rendezvous %}
                    <tr>
                        <td class="ps-4">
                            <div class="fw-bold text-dark">
                                <i class="bi bi-calendar3 text-primary me-2"></i>{{ rdv.date ? rdv.date|date('d/m/Y') : '—' }}
                            </div>
                            <div class="small text-muted ms-4">{{ rdv.date ? rdv.date|date('H:i') : '' }}</div>
                        </td>
                        <td>
                            {% if rdv.client %}
                            <div class="d-flex align-items-center">
                                {% if rdv.client.image %}
                                    <img src="{{ asset('uploads/clients/' ~ rdv.client.image) }}" class="avatar avatar-sm me-2" alt="{{ rdv.client.fullName }}">
                                {% else %}
                                    <div class="avatar avatar-sm bg-success bg-opacity-10 text-success me-2 fw-bold">{{ rdv.client.nom|slice(0,1)|upper }}</div>
                                {% endif %}
                                <span class="fw-semibold">{{ rdv.client.fullName }}</span>
                            </div>
                            {% else %}
                            <span class="text-muted fst-italic">Non assigné</span>
                            {% endif %}
                        </td>
                        <td>
                            {% set stClass = rdv.status == 'Terminé' ? 'success' : (rdv.status == 'Annulé' ? 'danger' : 'info') %}
                            <span class="status-badge status-{{ stClass }}">
                                <i class="bi bi-circle-fill" style="font-size:0.45rem;"></i> {{ rdv.status ?? 'Planifié' }}
                            </span>
                        </td>
                        <td class="pe-4">
                            <div class="crud-actions">
                                <a href="{{ path('app_rendez_vous_show', {'id': rdv.id}) }}" class="crud-btn crud-btn-view" title="Voir"><i class="bi bi-eye"></i></a>
                                <a href="{{ path('app_rendez_vous_edit', {'id': rdv.id}) }}" class="crud-btn crud-btn-edit" title="Modifier"><i class="bi bi-pencil"></i></a>
                                <form method="post" action="{{ path('app_rendez_vous_delete', {'id': rdv.id}) }}" style="display:inline-block;" onsubmit="return confirm('Êtes-vous sûr ?');">
                                    <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ rdv.id) }}">
                                    <button class="crud-btn crud-btn-delete" title="Supprimer"><i class="bi bi-trash"></i></button>
                                </form>
                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4">
                            <div class="crud-empty">
                                <div class="crud-empty-icon"><i class="bi bi-calendar-x"></i></div>
                                <h5>Aucun rendez-vous planifié</h5>
                                <p>Votre agenda est libre. Programmez une nouvelle consultation.</p>
                                <a href="{{ path('app_rendez_vous_new') }}" class="btn btn-primary"><i class="bi bi-plus-lg me-2"></i>Nouveau RDV</a>
                            </div>
                        </td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
</div>
{% endblock %}
