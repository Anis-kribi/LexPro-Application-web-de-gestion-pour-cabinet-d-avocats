{{ form_start(form, {'attr': {'class': 'needs-validation'}}) }}

<div class="row g-4">
    <div class="col-12">
        <div class="form-section-title"><i class="bi bi-calendar-event"></i> Détails du Rendez-vous</div>
    </div>

    <div class="col-md-6">
        <div class="form-group">
            {{ form_label(form.date) }}
            <div class="input-group">
                <span class="input-group-text bg-light"><i class="bi bi-clock text-muted"></i></span>
                {{ form_widget(form.date, {'attr': {'class': 'form-control'}}) }}
            </div>
            <div class="text-danger small mt-1">{{ form_errors(form.date) }}</div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="form-group">
            {{ form_label(form.status) }}
            {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.status) }}</div>
        </div>
    </div>

    <div class="col-12 mt-2">
        <div class="form-section-title"><i class="bi bi-people"></i> Client</div>
    </div>

    <div class="col-md-12">
        <div class="form-group">
            {{ form_label(form.client) }}
            {{ form_widget(form.client, {'attr': {'class': 'form-select select2'}}) }}
            <div class="text-danger small mt-1">{{ form_errors(form.client) }}</div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 border-top mt-4 pt-4">
    <a href="{{ path('app_rendez_vous_index') }}" class="btn btn-light">Annuler</a>
    <button class="btn btn-primary"><i class="bi bi-check2-circle me-2"></i>{{ button_label|default('Planifier') }}</button>
</div>

{{ form_end(form) }}