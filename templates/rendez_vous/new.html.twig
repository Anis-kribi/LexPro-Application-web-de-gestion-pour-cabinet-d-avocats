{% extends 'baseback.html.twig' %}

{% block title %}Nouveau Rendez-vous — LexPro{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_rendez_vous_index') }}" class="btn btn-light border" title="Retour">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_rendez_vous_index') }}"><i class="bi bi-calendar-event me-1"></i>Rendez-vous</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Nouveau</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Planifier un Rendez-vous</h1>
            <p class="text-muted">Ajoutez une nouvelle réunion ou consultation avec un client.</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-calendar-plus text-primary me-2"></i>Détails du rendez-vous</h6>
            </div>
            <div class="card-body p-4">
                {{ include('rendez_vous/_form.html.twig') }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-calendar-event"></i> Agenda</div>
            <ul>
                <li><i class="bi bi-info-circle"></i> Sélectionnez le client concerné par ce rendez-vous.</li>
                <li><i class="bi bi-info-circle"></i> La date et l'heure sont obligatoires.</li>
            </ul>
        </div>
    </div>
</div>
{% endblock %}