{{ form_start(form, {'attr': {'class': 'needs-validation invoice-form'}}) }}

<div class="row g-4">
    <div class="col-md-3">
        <div class="form-group mb-3">
            {{ form_label(form.numeroFacture) }}
            {{ form_widget(form.numeroFacture, {'attr': {'class': 'form-control', 'readonly': (app.request.attributes.get('_route') == 'app_factures_edit')}}) }}
            <div class="text-danger small">{{ form_errors(form.numeroFacture) }}</div>
        </div>
    </div>
    <div class="col-md-5">
        <div class="form-group mb-3">
            {{ form_label(form.client) }}
            {{ form_widget(form.client, {'attr': {'class': 'form-select select2'}}) }}
            <div class="text-danger small">{{ form_errors(form.client) }}</div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="form-group mb-3">
            {{ form_label(form.dossier) }}
            {{ form_widget(form.dossier, {'attr': {'class': 'form-select select2'}}) }}
            <div class="text-danger small">{{ form_errors(form.dossier) }}</div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="form-group mb-3">
            {{ form_label(form.dateEmission) }}
            {{ form_widget(form.dateEmission, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            {{ form_label(form.dateEcheance) }}
            {{ form_widget(form.dateEcheance, {'attr': {'class': 'form-control'}}) }}
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            {{ form_label(form.status) }}
            {{ form_widget(form.status, {'attr': {'class': 'form-select'}}) }}
        </div>
    </div>
    <div class="col-md-3">
        <div class="form-group mb-3">
            {{ form_label(form.tva) }}
            <div class="input-group">
                {{ form_widget(form.tva, {'attr': {'class': 'form-control text-end tva-input'}}) }}
                <span class="input-group-text">%</span>
            </div>
            <div class="text-danger small">{{ form_errors(form.tva) }}</div>
        </div>
    </div>

    <!-- Section Articles de Facturation -->
    <div class="col-12 mt-5">
        <h5 class="fw-bold border-bottom pb-2 mb-3"><i class="bi bi-list-columns-reverse text-primary me-2"></i>Lignes de facturation</h5>
        
        <div class="table-responsive">
            <table class="table table-bordered mb-0" id="articles-table">
                <thead class="table-light">
                    <tr>
                        <th style="width: 50%;">Description de la prestation</th>
                        <th style="width: 15%; text-align: center;">Quantité</th>
                        <th style="width: 15%; text-align: right;">Prix Unitaire HT</th>
                        <th style="width: 15%; text-align: right;">Total HT</th>
                        <th style="width: 5%;"></th>
                    </tr>
                </thead>
                <tbody class="articles-collection" data-index="{{ form.articles|length > 0 ? form.articles|last.vars.name + 1 : 0 }}" data-prototype="{{ include('factures/_article_prototype.html.twig', { 'item': form.articles.vars.prototype })|e('html_attr') }}">
                    {% for articleForm in form.articles %}
                        {{ include('factures/_article_prototype.html.twig', { 'item': articleForm }) }}
                    {% endfor %}
                </tbody>
                <tfoot>
                    <tr>
                        <td colspan="5" class="text-center p-3">
                            <button type="button" class="btn btn-sm btn-outline-primary add-article-btn"><i class="bi bi-plus-circle me-1"></i>Ajouter une ligne de prestation</button>
                        </td>
                    </tr>
                </tfoot>
            </table>
        </div>
    </div>

    <!-- Résumé Financier -->
    <div class="col-12 d-flex justify-content-end mt-4">
        <div class="col-md-4">
            <div class="card bg-light border-0">
                <div class="card-body">
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">Total HT</span>
                        <span class="fw-bold" id="total_ht">0.00 DT</span>
                    </div>
                    <div class="d-flex justify-content-between mb-2">
                        <span class="text-muted">TVA (<span id="tva_lbl">{{ form.tva.vars.value|default(20) }}</span>%)</span>
                        <span class="fw-bold" id="total_tva">0.00 DT</span>
                    </div>
                    <div class="d-flex justify-content-between border-top pt-2 mt-2">
                        <span class="fw-bold fs-5">Total TTC</span>
                        <span class="fw-bold text-success fs-5" id="total_ttc">0.00 DT</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="d-flex justify-content-end gap-2 border-top mt-4 pt-4">
    <a href="{{ path('app_factures_index') }}" class="btn btn-light border">Annuler</a>
    <button class="btn btn-primary">{{ button_label|default('Enregistrer la facture') }}</button>
</div>

{{ form_end(form, {'render_rest': false}) }}

<script>
document.addEventListener('DOMContentLoaded', function() {
    const collectionHolder = document.querySelector('.articles-collection');
    const addButton = document.querySelector('.add-article-btn');
    const tvaInput = document.querySelector('.tva-input');

    // Add first item if empty
    if (collectionHolder.children.length === 0) {
        addArticleForm(collectionHolder);
    }

    addButton.addEventListener('click', function() {
        addArticleForm(collectionHolder);
    });

    function addArticleForm(collectionHolder) {
        let prototype = collectionHolder.dataset.prototype;
        let index = collectionHolder.dataset.index;
        let newForm = prototype.replace(/__name__/g, index);
        collectionHolder.dataset.index = parseInt(index) + 1;
        
        const tr = document.createElement('tr');
        tr.className = 'article-item';
        tr.innerHTML = newForm;
        collectionHolder.appendChild(tr);

        attachEventListeners(tr);
        calculateInvoiceTotal();
    }

    function attachEventListeners(tr) {
        const removeBtn = tr.querySelector('.remove-article-btn');
        if (removeBtn) {
            removeBtn.addEventListener('click', function() {
                tr.remove();
                calculateInvoiceTotal();
            });
        }

        const qteInput = tr.querySelector('.article-qte');
        const prixInput = tr.querySelector('.article-prix');

        if (qteInput) qteInput.addEventListener('input', updateLineTotal);
        if (prixInput) prixInput.addEventListener('input', updateLineTotal);
    }

    function updateLineTotal(e) {
        const tr = e.target.closest('tr');
        const qte = parseFloat(tr.querySelector('.article-qte').value) || 0;
        const prix = parseFloat(tr.querySelector('.article-prix').value) || 0;
        const totalHtml = tr.querySelector('.line-total');
        
        const total = qte * prix;
        if(totalHtml) totalHtml.textContent = total.toFixed(2) + ' DT';
        
        calculateInvoiceTotal();
    }

    function calculateInvoiceTotal() {
        let totalHT = 0;
        document.querySelectorAll('.article-item').forEach(tr => {
            const qte = parseFloat(tr.querySelector('.article-qte').value) || 0;
            const prix = parseFloat(tr.querySelector('.article-prix').value) || 0;
            totalHT += qte * prix;
        });

        const tvaRate = parseFloat(tvaInput.value) || 0;
        const totalTVA = totalHT * (tvaRate / 100);
        const totalTTC = totalHT + totalTVA;

        document.getElementById('total_ht').textContent = totalHT.toFixed(2) + ' DT';
        document.getElementById('tva_lbl').textContent = tvaRate;
        document.getElementById('total_tva').textContent = totalTVA.toFixed(2) + ' DT';
        document.getElementById('total_ttc').textContent = totalTTC.toFixed(2) + ' DT';
    }

    // Attach events to existing items
    document.querySelectorAll('.article-item').forEach(attachEventListeners);
    tvaInput.addEventListener('input', calculateInvoiceTotal);
    
    // Initial calc
    document.querySelectorAll('.article-item').forEach(tr => {
       const qte = parseFloat(tr.querySelector('.article-qte').value) || 0;
       const prix = parseFloat(tr.querySelector('.article-prix').value) || 0;
       const totalHtml = tr.querySelector('.line-total');
       if(totalHtml) totalHtml.textContent = (qte*prix).toFixed(2) + ' DT';
    });
    calculateInvoiceTotal();
});
</script>