{% extends 'baseback.html.twig' %}

{% block title %} Dashboard - LexPro{% endblock %}

{% block body %}
{# Page Header #}
<div class="page-header animate-fade-in mb-4">
    <div class="d-flex justify-content-between align-items-center">
        <div>
            <h1 class="text-gradient"><i class="bi bi-grid-1x2-fill me-2"></i>Tableau de Bord</h1>
            <p class="text-muted mb-0">Vue d'ensemble de votre activité</p>
        </div>
        <div class="d-flex gap-2">
            <a href="{{ path('app_dossier_new') }}" class="btn btn-primary">
                <i class="bi bi-folder-plus me-2"></i>Nouveau Dossier
            </a>
        </div>
    </div>
</div>

{# Statistics Cards #}
<div class="row g-4 mb-4">
    {# Dossiers en cours #}
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card animate-slide-up" style="animation-delay: 0.1s;">
            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-primary bg-opacity-10 text-primary px-2 py-1 small fw-semibold">DOSSIERS</span>
                    </div>
                    <div class="stat-value text-dark">{{ dossiers_en_cours }}</div>
                    <p class="text-muted small mb-0">En cours sur {{ total_dossiers }}</p>
                </div>
                <div class="stat-icon bg-primary bg-opacity-10 text-primary">
                    <i class="bi bi-folder2-open"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a href="{{ path('app_dossier_index') }}?statut=En+cours" class="btn btn-light text-primary btn-sm w-100 fw-semibold hover-lift">
                    Voir les dossiers en cours
                </a>
            </div>
        </div>
    </div>

    {# Tâches #}
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card animate-slide-up" style="animation-delay: 0.15s;">
            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-warning bg-opacity-10 text-warning px-2 py-1 small fw-semibold">TÂCHES</span>
                    </div>
                    <div class="stat-value text-dark">{{ taches_a_faire }}</div>
                    <p class="text-muted small mb-0">{% if taches_en_retard > 0 %}<span class="text-danger fw-bold">{{ taches_en_retard }} en retard</span>{% else %}A faire{% endif %}</p>
                </div>
                <div class="stat-icon bg-warning bg-opacity-10 text-warning">
                    <i class="bi bi-list-check"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a href="{{ path('app_tache_index') }}" class="btn btn-light text-warning btn-sm w-100 fw-semibold hover-lift">
                    Gérer les tâches
                </a>
            </div>
        </div>
    </div>

    {# Facturation Mois #}
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card animate-slide-up" style="animation-delay: 0.2s;">
            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 small fw-semibold">FACTURATION</span>
                    </div>
                    <div class="stat-value text-dark">{{ total_ttc_mois|number_format(2, ',', ' ') }} DT</div>
                    <p class="text-muted small mb-0">{{ factures_mois }} factures ce mois</p>
                </div>
                <div class="stat-icon bg-success bg-opacity-10 text-success">
                    <i class="bi bi-cash-coin"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a href="{{ path('app_factures_index') }}" class="btn btn-light text-success btn-sm w-100 fw-semibold hover-lift">
                    {% if factures_en_retard > 0 %} <span class="text-danger fw-bold">{{ factures_en_retard }} en retard</span> {% else %} Historique {% endif %}
                </a>
            </div>
        </div>
    </div>

    {# Temps Facturable #}
    <div class="col-12 col-sm-6 col-xl-3">
        <div class="stat-card animate-slide-up" style="animation-delay: 0.25s;">
            <div class="d-flex justify-content-between align-items-start">
                <div class="flex-grow-1">
                    <div class="d-flex align-items-center mb-2">
                        <span class="badge bg-info bg-opacity-10 text-info px-2 py-1 small fw-semibold">TEMPS MOIS</span>
                    </div>
                    <div class="stat-value text-dark">{{ heures_fact_mois|number_format(1, ',', ' ') }}h</div>
                    <p class="text-muted small mb-0">Heures facturables</p>
                </div>
                <div class="stat-icon bg-info bg-opacity-10 text-info">
                    <i class="bi bi-clock-history"></i>
                </div>
            </div>
            <div class="mt-3 pt-3 border-top">
                <a href="{{ path('app_entree_temps_new') }}" class="btn btn-light text-info btn-sm w-100 fw-semibold hover-lift">
                    Saisir du temps
                </a>
            </div>
        </div>
    </div>
</div>

{# Main Content Area #}
<div class="row g-4">
    {# Tâches Urgentes #}
    <div class="col-12 col-lg-5">
        <div class="card border-0 shadow-sm h-100 animate-slide-up" style="animation-delay: 0.3s;">
            <div class="card-header bg-transparent border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-exclamation-triangle text-danger me-2"></i>Tâches Urgentes</h5>
                <a href="{{ path('app_tache_index') }}" class="btn btn-sm btn-light">Tout voir</a>
            </div>
            <div class="card-body p-0">
                {% if taches_urgentes|length > 0 %}
                <div class="list-group list-group-flush">
                    {% for tache in taches_urgentes %}
                    <div class="list-group-item px-4 py-3 border-0 border-bottom">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h6 class="mb-1 fw-semibold text-dark">{{ tache.titre }}</h6>
                                <p class="mb-1 text-muted small">
                                    <i class="bi bi-folder me-1"></i> <a href="{{ path('app_dossier_show', {id: tache.dossier.id}) }}" class="text-decoration-none">{{ tache.dossier.titre }}</a>
                                </p>
                                {% if tache.dateEcheance %}
                                <span class="badge {% if tache.enRetard %}bg-danger{% else %}bg-warning text-dark{% endif %}">
                                    <i class="bi bi-calendar-event me-1"></i>{{ tache.dateEcheance|date('d/m/Y') }}
                                </span>
                                {% endif %}
                                <span class="badge bg-danger ms-1">{{ tache.priorite }}</span>
                            </div>
                            <div>
                                <form method="post" action="{{ path('app_tache_change_status', {'id': tache.id, 'status': 'Terminée'}) }}" style="display:inline-block;">
                                    <button class="btn btn-sm btn-outline-success rounded-circle" title="Marquer comme terminée"><i class="bi bi-check-lg"></i></button>
                                </form>
                            </div>
                        </div>
                    </div>
                    {% endfor %}
                </div>
                {% else %}
                <div class="text-center py-5 text-muted">
                    <i class="bi bi-check-circle fs-1 text-success mb-3 d-block"></i>
                    Aucune tâche urgente ou en retard.
                </div>
                {% endif %}
            </div>
        </div>
    </div>

    {# Recent Cases / Clients #}
    <div class="col-12 col-lg-7">
        <div class="card border-0 shadow-sm h-100 animate-slide-up" style="animation-delay: 0.35s;">
            <div class="card-header bg-transparent border-0 py-3 px-4 d-flex justify-content-between align-items-center">
                <h5 class="mb-0 fw-bold text-dark"><i class="bi bi-folder-plus text-primary me-2"></i>Derniers Dossiers</h5>
                <a href="{{ path('app_dossier_index') }}" class="btn btn-sm btn-light">Tout voir</a>
            </div>
            <div class="card-body p-0">
                {% if recent_dossiers|length > 0 %}
                <div class="table-responsive">
                    <table class="table table-hover mb-0 align-middle">
                        <thead class="table-light">
                            <tr>
                                <th class="ps-4">Référence</th>
                                <th>Client / Titre</th>
                                <th>Statut</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for dossier in recent_dossiers %}
                            <tr>
                                <td class="ps-4 fw-semibold text-primary">
                                    <a href="{{ path('app_dossier_show', {id: dossier.id}) }}" class="text-decoration-none">{{ dossier.numeroReference }}</a>
                                </td>
                                <td>
                                    <div class="fw-bold">{{ dossier.titre }}</div>
                                    <div class="small text-muted">{{ dossier.client.fullName }}</div>
                                </td>
                                <td>
                                    <span class="badge bg-success bg-opacity-10 text-success px-2 py-1 rounded-pill">{{ dossier.statuts }}</span>
                                </td>
                            </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% else %}
                <div class="text-center py-5 text-muted">
                    Aucun dossier récent.
                </div>
                {% endif %}
            </div>
        </div>
    </div>
</div>

{# Chart area #}
<div class="row mt-4">
    <div class="col-12">
         <div class="card border-0 shadow-sm animate-slide-up" style="animation-delay: 0.4s;">
            <div class="card-header bg-transparent border-0 py-4 px-4">
                <h5 class="mb-1 fw-bold text-dark"><i class="bi bi-graph-up me-2 text-primary"></i>Évolution Facturation (TTC) - 6 derniers mois</h5>
            </div>
            <div class="card-body p-4">
                <canvas id="facturesChart" height="250"></canvas>
            </div>
        </div>
    </div>
</div>

{% endblock %}

{% block javascripts %}
<script>
    document.addEventListener('DOMContentLoaded', function() {
        const ctx = document.getElementById('facturesChart');
        if (ctx) {
            const labels = {{ chart_labels|raw }};
            const data   = {{ chart_factures|raw }};

            new Chart(ctx.getContext('2d'), {
                type: 'bar',
                data: {
                    labels: labels,
                    datasets: [{
                        label: 'Chiffre d\'Affaires TTC (DT)',
                        data: data,
                        backgroundColor: 'rgba(13, 110, 253, 0.7)',
                        borderRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true }
                    }
                }
            });
        }
    });
</script>
{% endblock %}
