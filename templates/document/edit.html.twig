{% extends 'baseback.html.twig' %}

{% block title %}Modifier Document — LexPro{% endblock %}

{% block body %}
<div class="page-header mb-4">
    <div class="d-flex align-items-center gap-3">
        <a href="{{ path('app_document_show', {'id': document.id}) }}" class="btn btn-light border" title="Retour">
            <i class="bi bi-arrow-left"></i>
        </a>
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a href="{{ path('app_document_index') }}"><i class="bi bi-file-earmark-text me-1"></i>Documents</a></li>
                    <li class="breadcrumb-item"><a href="{{ path('app_document_show', {'id': document.id}) }}">{{ document.titre|slice(0, 30) }}{% if document.titre|length > 30 %}...{% endif %}</a></li>
                    <li class="breadcrumb-item active" aria-current="page">Modifier</li>
                </ol>
            </nav>
            <h1 class="mb-0 fw-bold">Modifier Document</h1>
            <p class="text-muted">Type: {{ document.type }} — Dossier: {{ document.dossier.numeroReference }}</p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-8">
        <div class="card border-0 shadow-sm">
            <div class="card-header bg-white border-bottom py-3">
                <h6 class="mb-0 fw-bold"><i class="bi bi-pencil text-primary me-2"></i>Informations du document</h6>
            </div>
            <div class="card-body p-4">
                {{ include('document/_form.html.twig', {'button_label': 'Mettre à jour'}) }}
            </div>
        </div>
    </div>
    <div class="col-lg-4">
        <div class="help-card mb-4">
            <div class="help-card-title"><i class="bi bi-shield-check"></i> Fichier actuel</div>
            <p class="small text-muted mb-3">Si vous uploadez un nouveau fichier, l'ancien sera remplacé. Laissez le champ vide pour conserver le fichier actuel.</p>
            <div class="d-grid">
                <a href="{{ path('app_document_download', {'id': document.id}) }}" class="btn btn-outline-primary btn-sm"><i class="bi bi-download me-2"></i>Télécharger le fichier actuel</a>
            </div>
        </div>
        <div class="card border-0 shadow-sm">
            <div class="card-body p-3">
                <a href="{{ path('app_document_show', {'id': document.id}) }}" class="btn btn-light border w-100 mb-2">
                    <i class="bi bi-eye me-2"></i>Voir le document
                </a>
            </div>
        </div>
    </div>
</div>
{% endblock %}